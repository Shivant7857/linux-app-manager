[Desktop Entry]
Name=Linux App Manager
Comment=Manage, backup, clone, and install .deb, Flatpak, Snap, and AppImage applications
Exec=linux-app-manager %F
Icon=linux-app-manager
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;
Keywords=package;flatpak;snap;deb;appimage;uninstall;remove;install;manager;backup;clone;restore;
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-debian-package;application/vnd.flatpak;application/vnd.flatpak.ref;application/vnd.flatpak.repo;application/x-executable;application/x-appimage;application/x-linux-app-manager-backup;
StartupNotify=true
