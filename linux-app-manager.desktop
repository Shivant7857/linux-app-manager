[Desktop Entry]
Name=Linux App Manager
Comment=Manage, open, and uninstall .deb, Flatpak, Snap, and AppImage applications
Exec=linux-app-manager
Icon=linux-app-manager
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;
Keywords=package;flatpak;snap;deb;appimage;uninstall;remove;manager;
StartupNotify=true
